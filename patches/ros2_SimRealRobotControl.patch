+# HIDE THE ABB LOGO (logo:=false): use copies of the IRB-120 link_3/link_4 visual meshes whose
+# red logo material (Material_9) gets the body colour (Material_3). Geometry is unchanged.
+def HideABBLogo(urdf_xml):
+    import re
+    src_dir = os.path.join(get_package_share_directory("ros2srrc_robots"), "irb120", "meshes", "visual")
+    out_dir = os.path.join(os.path.expanduser("~"), ".cache", "ros2srrc", "irb120_nologo")
+    os.makedirs(out_dir, exist_ok=True)
+    for name in ("link_3", "link_4"):
+        src, dst = os.path.join(src_dir, name + ".dae"), os.path.join(out_dir, name + ".dae")
+        if not os.path.exists(dst) or os.path.getmtime(dst) < os.path.getmtime(src):
+            mesh = open(src).read()
+            logo = re.search(r'<effect id="Material_9-effect">.*?</effect>', mesh, re.S)
+            body = re.search(r'<effect id="Material_3-effect">.*?</effect>', mesh, re.S)
+            if not (logo and body):
+                continue
+            new = logo.group(0)
+            for sid in ("emission", "diffuse"):
+                colour = r'<color sid="%s">([^<]+)</color>' % sid
+                new = re.sub(colour, '<color sid="%s">%s</color>' % (sid, re.search(colour, body.group(0)).group(1)), new)
+            tmp = dst + ".%d.tmp" % os.getpid()
+            open(tmp, "w").write(mesh.replace(logo.group(0), new))
+            os.replace(tmp, dst)
+        urdf_xml = re.sub(r'file://[^"\s]*/irb120/meshes/visual/%s\.dae' % name, "file://" + dst, urdf_xml)
+    return urdf_xml
+
